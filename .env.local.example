# Google Analytics Tracking ID
# Get this from your Google Analytics account
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# HubSpot Configuration
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_portal_id
NEXT_PUBLIC_HUBSPOT_REGION=na2

# HubSpot Form IDs
# Get these from your HubSpot form embed codes
NEXT_PUBLIC_HUBSPOT_FORM_ID=legacy_form_id
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=general_contact_form_id
NEXT_PUBLIC_HUBSPOT_DEMO_FORM_ID=demo_request_form_id
NEXT_PUBLIC_HUBSPOT_TAK_FORM_ID=tak_service_interest_form_id
NEXT_PUBLIC_HUBSPOT_RESOURCE_FORM_ID=resource_download_form_id

# Sentry Error Tracking
# Get your DSN from https://sentry.io/ after creating a project
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Sentry Build Configuration (Optional - for source maps upload)
# Only needed if you want to upload source maps to Sentry
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
